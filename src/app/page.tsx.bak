                </div>
                <ChevronRight className="w-5 h-5 text-gray-400" />
              </div>
              <div className="bg-pink-50 rounded-xl p-4 flex items-center justify-between cursor-pointer" onClick={() => setSubPage("heritage")}>
                <div className="flex items-center gap-3">
                  <span className="text-2xl">🎁</span>
                  <div>
                    <p className="font-semibold text-gray-900">Heritage Wallet</p>
                    <p className="text-sm text-gray-500">Smart contract custody</p>
                  </div>
                </div>
                <ChevronRight className="w-5 h-5 text-gray-400" />
