  const [subPage, setSubPage] = useState<string | null>(null);
  const [showBalance, setShowBalance] = useState(true);

  const tabs = [
    { id: "home", label: "Home", icon: Home },
    { id: "discover", label: "Discover", icon: Compass },
    { id: "profile", label: "Profile", icon: User },
  ];

  if (subPage === "heritage") return <HeritagePage onBack={() => setSubPage(null)} />;
  if (subPage === "create") return <CreateWallet onWalletCreated={() => setSubPage(null)} wallet={wallet} />;
  if (subPage === "import") return <ImportWallet onWalletImported={() => setSubPage(null)} wallet={wallet} />;
  if (subPage === "sign") return <SignMessage wallet={wallet} />;
  if (subPage === "security") return <WalletSecurity wallet={wallet} />;
  if (subPage === "shop") return <ShopTab wallet={wallet} addresses={chainAddresses} onNavigate={setSubPage} purchaseIntent={purchaseIntent} />;
  if (subPage === "ai") return <AIIntent wallet={wallet} onNavigate={setSubPage} onAction={() => {}} />;

  return (
    <div className="min-h-screen bg-gray-50 flex flex-col">
      <main className="flex-1 pb-20">
        {activeTab === "home" && (
          <div className="bg-white min-h-screen">
            <div className="bg-gradient-to-b from-blue-500 to-blue-600 px-6 pt-12 pb-8 text-white">
              <div className="flex items-center justify-between mb-6">
                <h1 className="text-lg font-medium opacity-90">Total Assets</h1>
                <button onClick={() => setShowBalance(!showBalance)} className="p-2">
                  {showBalance ? <Eye className="w-5 h-5 opacity-70" /> : <EyeOff className="w-5 h-5 opacity-70" />}
                </button>
              </div>
              <div className="text-center">
                <p className="text-4xl font-bold mb-1">{showBalance ? ",345.67" : "****"}</p>
                <p className="text-sm opacity-80">+2.34% (24h)</p>
              </div>
              <div className="flex justify-center gap-4 mt-8">
                <button className="flex flex-col items-center gap-1">
                  <div className="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center"><Send className="w-5 h-5" /></div>
                  <span className="text-xs">Send</span>
                </button>
                <button className="flex flex-col items-center gap-1">
                  <div className="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center"><QrCode className="w-5 h-5" /></div>
                  <span className="text-xs">Receive</span>
                </button>
                <button className="flex flex-col items-center gap-1">
                  <div className="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center"><ArrowLeftRight className="w-5 h-5" /></div>
                  <span className="text-xs">Swap</span>
                </button>
              </div>
            </div>
            <div className="px-4 py-4">
              <h2 className="text-sm font-semibold text-gray-500 mb-3 px-2">Assets</h2>
              <div className="bg-white rounded-2xl shadow-sm border divide-y">
                <div className="flex items-center justify-between p-4">
                  <div className="flex items-center gap-3">
                    <div className="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-sm bg-blue-600">ET</div>
                    <div>
                      <p className="font-semibold text-gray-900">Ethereum</p>
                      <p className="text-sm text-gray-400">0.5 ETH</p>
                    </div>
                  </div>
                  <div className="text-right">
                    <p className="font-semibold text-gray-900">,345.67</p>
                    <p className="text-sm text-green-500">+1.23%</p>
