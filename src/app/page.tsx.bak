        <div className="relative mb-8">
          <div className="w-24 h-24 bg-gradient-to-br from-blue-500 to-purple-600 rounded-3xl flex items-center justify-center shadow-lg">
            <Wallet className="w-12 h-12 text-white" />
          </div>
          <div className="absolute -bottom-2 -right-2 w-8 h-8 bg-gradient-to-br from-red-400 to-orange-400 rounded-xl flex items-center justify-center">
            <Sparkles className="w-4 h-4 text-white" />
          </div>
        </div>
        <h1 className="text-3xl font-bold text-gray-900 mb-2">AI Agent Wallet</h1>
        <p className="text-gray-500 mb-12">Your Digital World, Under Your Control</p>
        <div className="w-full max-w-sm space-y-3">
          <button onClick={onCreate} className="w-full bg-blue-500 text-white py-4 rounded-2xl font-semibold text-lg">Create New Wallet</button>
          <button onClick={onImport} className="w-full bg-white text-gray-900 py-4 rounded-2xl font-semibold text-lg border-2 border-gray-200 flex items-center justify-center gap-2">
            <Download className="w-5 h-5" /> Import Existing Wallet
          </button>
        </div>
      </div>
      <div className="px-6 py-8 bg-white border-t">
        <div className="flex items-center justify-center gap-6 text-xs text-gray-400">
          <div className="flex items-center gap-1"><Shield className="w-3.5 h-3.5" /><span>Local Encryption</span></div>
          <span>ETH / BTC / TRON</span>
          <span>Token Core</span>
        </div>
      </div>
    </div>
  );
}

function BackupPage({ onComplete }: { onComplete: () => void }) {
  const [step, setStep] = useState(1);
  const mnemonic = ["abandon", "ability", "able", "about", "above", "absent", "absorb", "abstract", "absurd", "abuse", "access", "accident"];
  const [hidden, setHidden] = useState(true);

  return (
    <div className="min-h-screen bg-white flex flex-col">
      <div className="px-6 py-4 flex items-center border-b">
        <div className="w-8" />
        <h1 className="flex-1 text-center text-lg font-semibold">Backup Mnemonic</h1>
        <div className="w-8" />
      </div>
      <div className="flex-1 px-6 py-6">
        {step === 1 && (
          <>
            <div className="text-center mb-6">
              <Shield className="w-16 h-16 text-blue-500 mx-auto mb-4" />
              <h2 className="text-xl font-bold mb-2">Securely Backup Your Mnemonic</h2>
              <p className="text-gray-500 text-sm">Mnemonic is the only way to recover your wallet</p>
            </div>
            <div className="bg-yellow-50 border border-yellow-200 rounded-xl p-4 mb-6">
              <p className="text-sm text-yellow-800"><strong>Important:</strong> Do not take screenshots, share online, or lose this.</p>
            </div>
            <button onClick={() => setStep(2)} className="w-full bg-blue-500 text-white py-4 rounded-xl font-semibold">I Understand, Start Backup</button>
          </>
        )}
        {step === 2 && (
          <>
            <div className="mb-4">
              <div className="flex items-center justify-between mb-3">
                <span className="text-sm text-gray-500">Your Mnemonic</span>
                <button onClick={() => setHidden(!hidden)} className="flex items-center gap-1 text-sm text-blue-500">
                  {hidden ? <Eye className="w-4 h-4" /> : <EyeOff className="w-4 h-4" />}
                  {hidden ? "Show" : "Hide"}
                </button>
              </div>
              {hidden ? (
                <div className="bg-gray-50 rounded-xl p-8 text-center"><p className="text-gray-500">Click Show to view mnemonic</p></div>
              ) : (
                <div className="bg-gray-50 rounded-xl p-4">
                  <div className="grid grid-cols-3 gap-2">
                    {mnemonic.map((word, i) => (
                      <div key={i} className="bg-white rounded-lg p-2 text-center border">
                        <span className="text-xs text-gray-400 mr-1">{i + 1}.</span>
                        <span className="text-sm font-medium">{word}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
            <button onClick={() => setStep(3)} className="w-full bg-blue-500 text-white py-4 rounded-xl font-semibold">Next</button>
          </>
        )}
        {step === 3 && (
          <>
            <div className="text-center mb-6">
              <div className="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <Shield className="w-8 h-8 text-green-600" />
              </div>
              <h2 className="text-xl font-bold mb-2">Confirm Backup Complete</h2>
              <p className="text-gray-500 text-sm">Make sure you have written down the mnemonic</p>
            </div>
            <div className="bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
              <p className="text-sm text-red-700 text-center">Lost mnemonic = Lost all assets forever</p>
            </div>
            <button onClick={onComplete} className="w-full bg-blue-500 text-white py-4 rounded-xl font-semibold">I Have Backed Up Safely, Enter Wallet</button>
          </>
        )}
      </div>
    </div>
  );
}

